[Unit]
Description=Clima AntaiSolar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clima
Group=clima
WorkingDirectory=/root/CLIMA/Clima/current
Environment=NODE_ENV=production
EnvironmentFile=/root/CLIMA/Clima/config/service.env
ExecStart=/root/CLIMA/Clima/current/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/root/CLIMA/Clima/database
CacheDirectory=clima-antaisolar-release-8507fa8

[Install]
WantedBy=multi-user.target
