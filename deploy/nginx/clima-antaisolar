server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name clima.antaisolar.com.br;
    client_max_body_size 1m;

    ssl_certificate /etc/letsencrypt/live/clima.antaisolar.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/clima.antaisolar.com.br/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/clima-access.log;
    error_log /var/log/nginx/clima-error.log;

    location ^~ /_next/static/ {
        alias /root/CLIMA/Clima2/app/dist/client/_next/static/;
        expires 365d;
        add_header Cache-Control "public, immutable";
    }
    location = /api/weather/archive { return 403; }
    location /api/ {
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
    location / {
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
server {
    listen 80;
    listen [::]:80;
    server_name clima.antaisolar.com.br;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://$host$request_uri; }
}
